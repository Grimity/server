generator client {
  provider = "prisma-client-js"
}

generator kysely {
  provider = "prisma-kysely"
  output   = "../src/database/kysely"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  url             String   @unique
  provider        String
  providerId      String
  email           String
  name            String   @unique
  image           String?
  description     String   @default("")
  backgroundImage String?
  links           String[] @default([])
  followerCount   Int      @default(0)
  subscription    String[] @default(["FOLLOW", "FEED_LIKE", "FEED_COMMENT", "FEED_REPLY", "POST_COMMENT", "POST_REPLY"])

  createdAt DateTime @default(now())

  followers                   Follow[]              @relation("following")
  followings                  Follow[]              @relation("follower")
  feeds                       Feed[]
  feedLikes                   Like[]
  feedComments                FeedComment[]         @relation("FeedCommentWrite")
  feedSaves                   Save[]
  feedCommentMentions         FeedComment[]         @relation("MentionedUser")
  feedCommentLikes            FeedCommentLike[]
  posts                       Post[]
  postLikes                   PostLike[]
  postSaves                   PostSave[]
  postComments                PostComment[]         @relation("PostCommentWrite")
  postCommentMentions         PostComment[]         @relation("MentionedUser")
  postCommentLike             PostCommentLike[]
  refreshToken                RefreshToken[]
  albums                      Album[]
  chatUsers                   ChatUser[]
  pushTokens                  PushToken[]
  blockers                    Block[]               @relation("blocker")
  blockings                   Block[]               @relation("blocking")
  identityVerification        IdentityVerification?
  commissions                 Commission[]
  commissionNotice            CommissionNotice?
  commissionWorksAsAuthor     CommissionWork[]      @relation("CommissionWorkAuthor")
  commissionWorksAsClient     CommissionWork[]      @relation("CommissionWorkClient")
  commissionReviewsAsReviewer CommissionReview[]    @relation("CommissionReviewReviewer")
  commissionReviewsAsReviewee CommissionReview[]    @relation("CommissionReviewReviewee")
  ownedBoards                 Board[]
  boardMembers                BoardMember[]

  @@unique([provider, providerId])
}

model IdentityVerification {
  userId                 String   @id @db.Uuid
  identityVerificationId String   @unique
  ci                     String   @unique
  name                   String
  phoneNumber            String
  birthDate              DateTime @db.Date
  gender                 String
  isForeigner            Boolean
  pgProvider             String
  pgTxId                 String
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

// 차단
model Block {
  blockerId  String   @db.Uuid
  blockingId String   @db.Uuid
  createdAt  DateTime @default(now())

  blocker  User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocking User @relation("blocking", fields: [blockingId], references: [id], onDelete: Cascade)

  @@id([blockingId, blockerId])
  @@index([blockerId, createdAt(sort: Desc)])
}

model Feed {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @db.Uuid
  title     String
  cards     String[]
  thumbnail String
  createdAt DateTime @default(now())
  viewCount Int      @default(0)
  likeCount Int      @default(0)
  content   String   @default("")
  albumId   String?  @db.Uuid
  tags      Tag[]

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    Like[]
  comments FeedComment[]
  saves    Save[]
  album    Album?        @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@index([authorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([albumId])
}

model Tag {
  feedId  String @db.Uuid
  tagName String

  feed Feed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@id([feedId, tagName])
  @@index([tagName])
}

model Like {
  userId    String   @db.Uuid
  feedId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  feed Feed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@id([userId, feedId])
  @@index([feedId])
}

model Save {
  userId    String   @db.Uuid
  feedId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  feed Feed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@id([userId, feedId])
}

model FeedComment {
  id              String   @id @default(uuid()) @db.Uuid
  feedId          String   @db.Uuid
  writerId        String   @db.Uuid
  parentId        String?  @db.Uuid
  content         String
  mentionedUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  likeCount       Int      @default(0)

  writer        User              @relation("FeedCommentWrite", fields: [writerId], references: [id], onDelete: Cascade)
  feed          Feed              @relation(fields: [feedId], references: [id], onDelete: Cascade)
  parent        FeedComment?      @relation("ChildComments", fields: [parentId], references: [id], onDelete: Cascade)
  childComments FeedComment[]     @relation("ChildComments")
  mentionedUser User?             @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: SetNull)
  likes         FeedCommentLike[]

  @@index([feedId])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  link      String
  image     String?
  message   String

  @@index([userId, createdAt(sort: Desc)])
}

model FeedCommentLike {
  feedCommentId String @db.Uuid
  userId        String @db.Uuid

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedComment FeedComment @relation(fields: [feedCommentId], references: [id], onDelete: Cascade)

  @@id([feedCommentId, userId])
}

model Post {
  id           String   @id @default(uuid()) @db.Uuid
  authorId     String   @db.Uuid
  title        String
  content      String
  type         Int      @db.SmallInt
  thumbnail    String?
  createdAt    DateTime @default(now())
  viewCount    Int      @default(0)
  commentCount Int      @default(0)

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  saves    PostSave[]
  comments PostComment[]

  @@index([authorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([type(sort: Asc), createdAt(sort: Desc)])
}

model PostLike {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model PostSave {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model PostComment {
  id              String   @id @default(uuid()) @db.Uuid
  postId          String   @db.Uuid
  writerId        String?  @db.Uuid
  parentId        String?  @db.Uuid
  content         String
  mentionedUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  likeCount       Int      @default(0)
  isDeleted       Boolean  @default(false)

  writer        User?             @relation("PostCommentWrite", fields: [writerId], references: [id], onDelete: SetNull)
  post          Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent        PostComment?      @relation("ChildComments", fields: [parentId], references: [id], onDelete: Cascade)
  childComments PostComment[]     @relation("ChildComments")
  mentionedUser User?             @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: SetNull)
  likes         PostCommentLike[]

  @@index([postId, createdAt(sort: Asc)])
}

model PostCommentLike {
  postCommentId String @db.Uuid
  userId        String @db.Uuid

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  postComment PostComment @relation(fields: [postCommentId], references: [id], onDelete: Cascade)

  @@id([postCommentId, userId])
}

model Report {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  userId    String   @db.Uuid
  refType   String
  refId     String   @db.Uuid
  content   String?
  createdAt DateTime @default(now())
}

model RefreshToken {
  userId    String   @db.Uuid
  token     String
  updatedAt DateTime @default(now())
  type      String
  device    String
  model     String
  ip        String
  deviceId  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, token])
}

model Album {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  name   String
  order  Int

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  feeds Feed[]

  @@index([userId])
}

model Chat {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  messages ChatMessage[]
  users    ChatUser[]

  @@index([createdAt(sort: Desc)])
}

enum ChatMessageType {
  USER // 일반 유저 메시지
  COMMISSION_REQUESTED // 커미션 신청 완료
  COMMISSION_ACCEPTED // 커미션 수락
  COMMISSION_REJECTED // 커미션 거절
  COMMISSION_CANCELED // 커미션 신청 취소(의뢰인)
  COMMISSION_RESULT_UPLOADED // 중간 작업물 업로드
  COMMISSION_FINAL_UPLOADED // 최종 작업물 도착
  COMMISSION_COMPLETED // 커미션 완료/종료
}

model ChatMessage {
  id          String          @id @default(uuid()) @db.Uuid
  chatId      String          @db.Uuid
  userId      String?         @db.Uuid // nullable: 시스템 메시지는 발신자 없음
  content     String? // 일반 메시지 본문 / 시스템 메시지 카드 문구
  image       String? // DEPRECATED: 레거시 단일 이미지(= images[0]), 호환용 유지
  images      String[]        @default([]) // 묶음 이미지(최대 5)
  type        ChatMessageType @default(USER) // 시스템 메시지 구분
  referenceId String?         @db.Uuid // 시스템 메시지 클릭 시 이동 대상(커미션 등) ID
  createdAt   DateTime        @default(now())
  replyToId   String?         @db.Uuid
  isLike      Boolean         @default(false)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt(sort: Asc)])
}

model ChatUser {
  chatId      String    @db.Uuid
  userId      String    @db.Uuid
  unreadCount Int       @default(0)
  enteredAt   DateTime?
  exitedAt    DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
}

model PushToken {
  userId    String   @db.Uuid
  deviceId  String
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, deviceId])
}

model AppVersion {
  version   String   @id
  createdAt DateTime @default(now())
}

model CommissionNotice {
  userId    String   @id @db.Uuid
  title     String
  content   String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Commission {
  id                  String    @id @default(uuid()) @db.Uuid
  authorId            String    @db.Uuid
  title               String
  description         String
  additionalCondition String?
  price               Int
  workDays            Int       @db.SmallInt
  revisionCount       Int       @db.SmallInt
  images              String[]
  thumbnail           String
  isPublic            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  deletedAt           DateTime?

  author    User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags      CommissionTag[]
  questions CommissionQuestion[]
  works     CommissionWork[]

  @@index([authorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model CommissionTag {
  commissionId String @db.Uuid
  tagName      String

  commission Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@id([commissionId, tagName])
  @@index([tagName])
}

model CommissionQuestion {
  commissionId String   @db.Uuid
  order        Int      @db.SmallInt
  type         String
  title        String
  description  String?
  isRequired   Boolean  @default(false)
  options      String[]

  commission Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@id([commissionId, order])
}

enum CommissionWorkStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  FINAL
  COMPLETED
  REJECTED
  CANCELED
}

model CommissionWork {
  id           String               @id @default(uuid()) @db.Uuid
  authorId     String               @db.Uuid
  clientId     String               @db.Uuid
  commissionId String?              @db.Uuid
  status       CommissionWorkStatus @default(PENDING)
  rejectReason String?
  rejectedAt   DateTime?
  createdAt    DateTime             @default(now())

  author     User                  @relation("CommissionWorkAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  client     User                  @relation("CommissionWorkClient", fields: [clientId], references: [id], onDelete: Cascade)
  commission Commission?           @relation(fields: [commissionId], references: [id], onDelete: SetNull)
  request    CommissionRequest?
  result     CommissionWorkResult?
  memos      CommissionWorkMemo[]
  events     CommissionWorkEvent[]
  reviews    CommissionReview[]

  @@index([authorId, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
}

enum CommissionReviewRating {
  SATISFIED
  NORMAL
  DISSATISFIED
}

model CommissionReview {
  id         String                 @id @default(uuid()) @db.Uuid
  workId     String                 @db.Uuid
  reviewerId String                 @db.Uuid
  revieweeId String                 @db.Uuid
  rating     CommissionReviewRating
  content    String?
  createdAt  DateTime               @default(now())

  work     CommissionWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  reviewer User           @relation("CommissionReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User           @relation("CommissionReviewReviewee", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([workId, reviewerId])
  @@index([revieweeId, createdAt(sort: Desc)])
}

enum CommissionWorkEventType {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELED
  RESULT_UPLOADED
  FINAL_UPLOADED
  COMPLETED
}

model CommissionWorkEvent {
  id        String                  @id @default(uuid()) @db.Uuid
  workId    String                  @db.Uuid
  type      CommissionWorkEventType
  createdAt DateTime                @default(now())

  work CommissionWork @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId, createdAt(sort: Desc)])
}

model CommissionWorkMemo {
  id        String   @id @default(uuid()) @db.Uuid
  workId    String   @db.Uuid
  content   String
  createdAt DateTime @default(now())

  work CommissionWork @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId, createdAt(sort: Desc)])
}

model CommissionRequest {
  workId          String   @id @db.Uuid
  /// [CommissionAnswer]
  answers         Json[]   @default([])
  referenceImages String[]
  createdAt       DateTime @default(now())

  work CommissionWork @relation(fields: [workId], references: [id], onDelete: Cascade)
}

model CommissionWorkResult {
  workId    String   @id @db.Uuid
  images    String[]
  isFinal   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  work CommissionWork @relation(fields: [workId], references: [id], onDelete: Cascade)
}

enum BoardLinkPermission {
  NONE // 초대 없이 접근 불가
  EDIT // 링크로 편집 가능
}

enum BoardMemberPermission {
  EDIT // 개별 초대로 편집 가능
}

model Board {
  id             String              @id @default(uuid()) @db.Uuid
  ownerId        String              @db.Uuid
  title          String              @default("새 그리미티 보드") @db.VarChar(100)
  linkPermission BoardLinkPermission @default(EDIT)
  lastSeq        Int                 @default(0) // 마지막으로 매긴 변경 순서. 보드 행을 잠그고 올린다
  maxMembers     Int? // 동시 참여 인원. null이면 서버 기본값(BOARD_MAX_MEMBERS)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members BoardMember[]
  strokes BoardStroke[]
  ops     BoardOp[]

  @@index([ownerId, createdAt(sort: Desc)])
}

// 보드에 참여한 사람 전체. 로그인 사용자는 userId, 게스트는 userId 없이 name으로 구분한다.
// 행이 있다고 권한이 있는 것은 아니다. 권한은 permission(개별 초대)과 링크 권한으로만 판단한다.
// 사용자가 탈퇴해도 다른 사람과 함께 그린 그림은 남긴다. 행은 userId·name이 모두 null인 익명 참여자로 남고 다시 입장에 쓸 수 없다.
model BoardMember {
  id         String                 @id @default(uuid()) @db.Uuid
  boardId    String                 @db.Uuid
  userId     String?                @db.Uuid
  name       String?                @db.VarChar(30) // 게스트 이름. 로그인 사용자는 User.name을 쓴다
  permission BoardMemberPermission? // null이면 링크로 들어온 참여자
  createdAt  DateTime               @default(now())

  board   Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  strokes BoardStroke[]
  ops     BoardOp[]

  // NULL끼리는 겹치지 않으므로 게스트 여러 명과 로그인 사용자 여러 명이 함께 있을 수 있다.
  @@unique([boardId, userId])
  @@unique([boardId, name])
  @@index([userId])
}

enum BoardStrokeTool {
  PEN
  ERASER
}

enum BoardEraseScope {
  OWN // 지우개를 쓴 사람의 그림만 지운다
  ALL // 모든 사람의 그림을 지운다. 보드 소유자만 쓴다
}

enum BoardOpType {
  HIDE // 내 획 숨기기(실행 취소)
  SHOW // 내 획 보이기(다시 실행)
  CLEAR // 내 획 모두 숨기기(전체 지우기). 삭제가 아니라서 운영에서 롤백할 수 있다
  MERGE // 게스트를 계정에 합침. data에 from/to
}

// 획 하나. 원본 입력을 그대로 저장한다(docs/board-socket.md 5-5). 렌더링 순서는 seq다.
model BoardStroke {
  boardId      String          @db.Uuid
  id           String          @db.Uuid // 클라이언트가 만든 ID. 같은 ID 재전송은 한 번만 반영한다
  seq          Int
  authorId     String          @db.Uuid // BoardMember.id
  v            Int // 획 스키마 버전
  tool         BoardStrokeTool
  eraseScope   BoardEraseScope @default(OWN)
  brushId      String          @db.VarChar(32)
  brushVersion Int
  color        String          @db.VarChar(7)
  size         Float
  channels     String[] // points 한 점의 값 순서. 예: x, y, pressure, t, tiltX, tiltY
  points       Json            @db.Json // 숫자 배열(channels 길이 × 점 개수). 내부를 조회하지 않으므로 json으로 둔다
  hiddenBySeq  Int? // null이면 보인다. 값은 이 획을 숨긴 작업의 seq
  createdAt    DateTime        @default(now())

  board  Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  // 참여자 행을 지워서 획이 함께 사라지는 일이 없게 한다. 보드 삭제 때는 같은 문장 안에서 함께 지워진다.
  author BoardMember @relation(fields: [authorId], references: [id], onDelete: NoAction)

  @@id([boardId, id])
  @@unique([boardId, seq])
  @@index([boardId, authorId])
}

// 획 추가 외에 그림 결과를 바꾸는 작업. 다시 연결한 클라이언트에 그대로 재생해 준다.
model BoardOp {
  boardId   String      @db.Uuid
  seq       Int
  id        String      @db.Uuid // 클라이언트가 만든 ID. 같은 ID 재전송은 한 번만 반영한다
  type      BoardOpType
  authorId  String      @db.Uuid
  strokeId  String?     @db.Uuid
  data      Json?
  createdAt DateTime    @default(now())

  board  Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author BoardMember @relation(fields: [authorId], references: [id], onDelete: NoAction)

  @@id([boardId, seq])
  @@unique([boardId, id])
  @@index([boardId, authorId, type, seq])
}
