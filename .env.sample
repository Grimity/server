# .env로 복사한 뒤 실행 환경에 맞게 채우세요. 기존 .env가 있다면 필요한 항목만 추가하세요.
# 빈 비밀값은 직접 설정해야 합니다. 실제 키/비밀번호는 이 파일에 저장하지 마세요.
# 아래 값은 예시이며, 코드 기본값인 항목은 따로 표시했습니다.

# 서버
NODE_ENV=development
PORT=3000
# 알림 링크에 사용할 프론트 주소
SERVICE_URL=http://localhost:3001

# PostgreSQL / Redis — 서버 실행에 필요
DATABASE_URL=postgresql://postgres:local-password@localhost:5432/grimity?schema=public
REDIS_HOST=localhost
# 코드 기본값: 6379. 비밀번호 없는 로컬 Redis는 REDIS_PASSWORD를 비워 둡니다.
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — secret은 각각 다른 충분히 긴 난수로 설정하세요.
# 기존 서버에 적용할 때는 기존 secret을 유지해야 이미 발급된 토큰이 유효합니다.
# 만료 기간은 예시입니다. 기존 운영 설정이 있으면 그 값을 유지하세요.
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# 웹 쿠키 인증 — 아래 세 값은 코드 기본값과 같습니다.
# 전체 API 접근 제한이 아니라 쿠키 인증/credentials를 허용할 웹 Origin 목록입니다.
# 쉼표로 구분하며 경로, 마지막 /, 와일드카드는 넣지 않습니다.
# 설정 시 기본 목록을 대체합니다. 기존 헤더 인증은 목록 밖에서도 사용할 수 있습니다.
AUTH_ALLOWED_ORIGINS=https://www.grimity.com,https://board.grimity.com,https://grimity.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
# 로컬 HTTP 쿠키 테스트 시 위 값을 다음과 같이 교체하세요.
# AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# AUTH_COOKIE_SECURE=false
# production 또는 SameSite=none에서는 AUTH_COOKIE_SECURE=true가 필요합니다.

# AWS S3 / 이미지 URL — 이미지 업로드·조회에 필요
AWS_REGION=ap-northeast-2
AWS_IMAGE_BUCKET_NAME=your-image-bucket
IMAGE_URL=https://images.example.com
# 인증은 실행 환경의 IAM 역할 또는 로컬 AWS 프로필을 사용할 수 있습니다.
# AWS_PROFILE=your-local-profile
# 환경변수로 자격증명을 제공할 경우 아래 항목을 채우세요.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Firebase Admin SDK — 현재 서버 시작 시 초기화하므로 유효한 설정이 필요합니다.
FIREBASE_ADMIN_SDK_PROJECT_ID=
FIREBASE_ADMIN_SDK_CLIENT_EMAIL=
# 서비스 계정의 PEM 개인키. 큰따옴표로 감싸고 줄바꿈은 \n으로 입력할 수 있습니다.
FIREBASE_ADMIN_SDK_PRIVATE_KEY=

# PortOne — 현재 서버 시작 시 설정을 읽습니다. 본인인증 연동용 키를 입력하세요.
PORTONE_API_SECRET=

# Gemini — 게시글 스팸 감지에 필요
GEMINI_API_KEY=

# 일단 대충
ADMIN_ID=
ADMIN_PASSWORD=
JWT_ADMIN_SECRET=
JWT_ADMIN_EXPIRES_IN=1h
# 공지/관리자 댓글에 사용할 기존 공식 계정의 User ID(UUID)
OFFICIAL_USER_ID=
